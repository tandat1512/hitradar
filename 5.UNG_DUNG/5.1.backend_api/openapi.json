            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Speechiness"
          },
          "acousticness": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Acousticness"
          },
          "instrumentalness": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
