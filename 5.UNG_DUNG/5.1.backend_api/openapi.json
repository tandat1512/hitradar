          "duration_min",
          "explicit",
          "release_year",
          "release_month",
          "decade",
          "release_precision",
          "danceability",
          "energy",
          "key",
          "loudness",
          "mode",
          "speechiness",
          "acousticness",
          "instrumentalness",
          "liveness",
          "valence",
          "tempo",
          "time_signature"
        ],
        "title": "ExplainRequest",
        "description": "Explain request uses the same 18-field input as PredictRequest.\n\nOptional controls (not yet in spec — reserved for future):\n- top_k: number of top features to return\n- include_all: return all 31 SHAP values"
      },
      "ExplainResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "prediction_raw": {
            "type": "number",
            "title": "Prediction Raw"
          },
          "prediction_clipped": {
            "type": "number",
            "title": "Prediction Clipped"
          },
          "prediction_display": {
            "type": "integer",
            "title": "Prediction Display"
          },
          "base_value": {
            "type": "number",
            "title": "Base Value",
            "description": "Expected (average) model output — shap.TreeExplainer.expected_value"
          },
          "shap_values": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Shap Values",
            "description": "SHAP value per selected feature (31 entries)"
          },
          "top_features": {
            "items": {
              "$ref": "#/components/schemas/TopFeature"
            },
            "type": "array",
            "title": "Top Features",
            "description": "Top 5 features by absolute SHAP magnitude"
          },
