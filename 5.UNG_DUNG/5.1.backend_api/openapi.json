          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "explanation_method": {
            "type": "string",
            "title": "Explanation Method",
            "description": "Explanation method identifier",
            "default": "SHAP_TreeExplainer"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "prediction_raw",
          "prediction_clipped",
          "prediction_display",
          "base_value",
          "shap_values",
          "top_features",
          "model_id",
          "model_version"
        ],
        "title": "ExplainResponse",
        "description": "Prediction result plus SHAP feature attribution.\n\nThe shap_values map covers all 31 selected features.\ntop_features lists the top 5 by absolute SHAP magnitude.\n\nIMPORTANT: SHAP values show feature importance, NOT causal relationships."
      },
