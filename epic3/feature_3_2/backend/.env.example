# ============================================================
# HitRadar Pro API — Environment Configuration
# ============================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit real secrets to version control.
# ============================================================

# --- Application ---
APP_NAME=HitRadar Pro API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- Server ---
HOST=127.0.0.1
PORT=8000
# Optional: prefix all routes, e.g. /api/v1
API_PREFIX=

# --- Artifacts (paths relative to repo root or absolute) ---
# Default: <repo>/artifacts/epic2
ARTIFACTS_PATH=
# Override individual paths if needed:
# PIPELINE_PATH=<repo>/artifacts/epic2/pipeline/full_inference_pipeline.joblib
# SCHEMAS_DIR=<repo>/artifacts/epic2/schemas
# METADATA_DIR=<repo>/artifacts/epic2/metadata
# EXAMPLES_DIR=<repo>/artifacts/epic2/examples

# --- Model Loading ---
# eager: load model at server startup (recommended)
# lazy:  load model on first request
MODEL_LOAD_STRATEGY=eager
# Set to true to fail startup if model is unavailable
FAIL_STARTUP_WHEN_MODEL_UNAVAILABLE=false

# --- Feature Flags ---
EXPLAIN_ENABLED=true
WHAT_IF_ENABLED=true

# --- CORS ---
# Comma-separated list of allowed origins.
# Do NOT use "*" with credentials=true.
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
# Comma-separated allowed request headers
CORS_ALLOWED_HEADERS=Accept,Accept-Language,Authorization,Content-Type,X-Request-ID
